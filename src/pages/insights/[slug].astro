---
import PostLayout from '../../layouts/PostLayout.astro';
import { getCollection, type CollectionEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('insights');
  return posts.map(post => ({
    params: { slug: post.data.slug },
    props: { post, allPosts: posts },
  }));
}

interface Props {
  post: CollectionEntry<'insights'>;
  allPosts: CollectionEntry<'insights'>[];
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Up to 2 most-recent other posts as "Continue reading"
const related = allPosts
  .filter(p => p.data.slug !== post.data.slug)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2)
  .map(p => ({
    href: `/insights/${p.data.slug}`,
    eyebrow: p.data.eyebrow,
    title: p.data.title,
    date: fmt(p.data.date),
    readMin: p.data.readMin,
    art: p.data.art,
  }));
---
<PostLayout frontmatter={post.data} related={related}>
  <Content />
</PostLayout>
