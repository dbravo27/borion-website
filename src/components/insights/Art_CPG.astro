---
// Art_CPG — 6 data islands connected to a central Decision Core.
// Used by BlogCard (height 240) and PostHero (height 360+).
// Scales fluidly: caller controls the wrapping container size.
---
<div class="art art-cpg">
  <svg viewBox="0 0 480 240" preserveAspectRatio="xMidYMid slice" class="art-svg" aria-hidden="true">
    <defs>
      <linearGradient id="cpgLine" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="var(--purple)" stop-opacity="0.7" />
        <stop offset="100%" stop-color="var(--blue)" stop-opacity="0.7" />
      </linearGradient>
      <radialGradient id="cpgCore" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--blue)" />
        <stop offset="100%" stop-color="var(--purple)" />
      </radialGradient>
    </defs>
    <line x1="57.6"  y1="52.8"  x2="240" y2="120" stroke="url(#cpgLine)" stroke-width="1" stroke-dasharray="2 4" opacity="0.55" />
    <line x1="374.4" y1="43.2"  x2="240" y2="120" stroke="url(#cpgLine)" stroke-width="1" stroke-dasharray="2 4" opacity="0.55" />
    <line x1="422.4" y1="139.2" x2="240" y2="120" stroke="url(#cpgLine)" stroke-width="1" stroke-dasharray="2 4" opacity="0.55" />
    <line x1="38.4"  y1="168"   x2="240" y2="120" stroke="url(#cpgLine)" stroke-width="1" stroke-dasharray="2 4" opacity="0.55" />
    <line x1="297.6" y1="192"   x2="240" y2="120" stroke="url(#cpgLine)" stroke-width="1" stroke-dasharray="2 4" opacity="0.55" />
    <line x1="153.6" y1="33.6"  x2="240" y2="120" stroke="url(#cpgLine)" stroke-width="1" stroke-dasharray="2 4" opacity="0.55" />
    <circle cx="240" cy="120" r="38" fill="none" stroke="var(--purple)" stroke-width="0.8" stroke-dasharray="2 3" opacity="0.5" />
    <circle cx="240" cy="120" r="22" fill="url(#cpgCore)" />
  </svg>
  <span class="island" style="left:12%;top:22%">POS</span>
  <span class="island" style="left:78%;top:18%">MEDIA</span>
  <span class="island" style="left:88%;top:58%">RETAIL</span>
  <span class="island" style="left:8%;top:70%">PRICING</span>
  <span class="island" style="left:62%;top:80%">RESEARCH</span>
  <span class="island" style="left:32%;top:14%">SHARE</span>
  <span class="core-label">Decision Core</span>
</div>

<style>
  .art-cpg{
    position:absolute; inset:0;
    background:
      radial-gradient(circle at 50% 50%, rgba(111,93,210,0.18), transparent 65%),
      linear-gradient(180deg, var(--lavender-soft) 0%, var(--cream) 100%);
  }
  .art-svg{ position:absolute; inset:0; width:100%; height:100%; }
  .island{
    position:absolute; transform:translate(-50%,-50%);
    font-family: var(--font-mono);
    font-size:9px; font-weight:600; letter-spacing:0.1em;
    color: var(--ink-mid);
    background: #fff;
    padding: 3px 8px; border-radius: 4px;
    border: 1px solid var(--line);
    white-space: nowrap;
  }
  .core-label{
    position:absolute; left:50%; top:50%;
    transform: translate(-50%, calc(-50% + 44px));
    font-family: var(--font-display);
    font-size: 9px; font-weight: 700; letter-spacing: 0.18em;
    color: var(--ink); text-transform: uppercase;
  }
</style>
