---
// Art_Handoff — model.pkl block · The Gap · in-production block
---
<div class="art art-handoff">
  <div class="block-left">
    <div class="files">
      <div>model.pkl</div>
      <div style="opacity:0.6">local.py</div>
      <div style="opacity:0.4">notebook.ipynb</div>
    </div>
    <div class="caption">MODEL READY</div>
  </div>

  <div class="gap">
    <svg viewBox="0 0 90 160" aria-hidden="true">
      <defs>
        <linearGradient id="trace-h3" x1="0%" y1="50%" x2="100%" y2="50%">
          <stop offset="0%" stop-color="var(--purple)" stop-opacity="0" />
          <stop offset="50%" stop-color="var(--purple)" stop-opacity="1" />
          <stop offset="100%" stop-color="var(--blue)" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path d="M 0 80 Q 25 60, 45 80 T 90 80"
        stroke="url(#trace-h3)" stroke-width="1.8" fill="none" stroke-dasharray="3 4" />
    </svg>
    <div class="gap-label">The Gap</div>
  </div>

  <div class="block-right">
    <div class="files files-live">
      <div>api · live</div>
      <div>monitor · on</div>
      <div>retrain · auto</div>
    </div>
    <div class="caption caption-live">IN PRODUCTION</div>
  </div>
</div>

<style>
  .art-handoff{
    position:absolute; inset:0; padding:32px;
    background: linear-gradient(180deg, var(--lavender-soft) 0%, var(--cream) 100%);
    display:flex; align-items:center; justify-content:center;
  }
  .block-left, .block-right{
    flex:1; height:160px; border-radius:10px;
    padding:14px; position:relative;
    display:flex; flex-direction:column; justify-content:space-between;
  }
  .block-left{ background:#fff; border:1px solid rgba(10,14,31,0.08); }
  .block-right{
    background: linear-gradient(135deg, var(--blue), var(--purple));
    box-shadow: 0 0 36px rgba(25,90,221,0.3); color:#fff;
  }
  .files{
    font-family: var(--font-mono); font-size:9px;
    color: var(--ink-dim); letter-spacing:0.05em;
  }
  .files-live{ color: rgba(255,255,255,0.9); }
  .caption{
    font-family: var(--font-display);
    font-size:10px; font-weight:700; color: var(--ink-mid);
    letter-spacing:0.14em; text-transform:uppercase;
  }
  .caption-live{ color:#fff; }
  .gap{
    width:90px; height:160px; position:relative;
    display:flex; align-items:center; justify-content:center;
  }
  .gap svg{ position:absolute; inset:0; width:100%; height:100%; }
  .gap-label{
    position:absolute; bottom:-2px;
    font-family: var(--font-display);
    font-size:9px; font-weight:700; color: var(--ink-dim);
    letter-spacing:0.18em; text-transform:uppercase; white-space:nowrap;
  }
</style>
