---
// Editorial divider — logo + "BORION AI · RESEARCH" label
// Placed between hero and article body
---
<div class="signature">
  <div class="signature-row">
    <span class="hairline"></span>
    <img src="/assets/borion-logo-dark.png" alt="BorionAI" />
    <span class="hairline"></span>
  </div>
  <div class="signature-label">Borion AI · Research</div>
</div>

<style>
  .signature{
    background: var(--cream);
    padding: 56px 60px 0;
    display:flex; flex-direction:column; align-items:center; gap:14px;
  }
  .signature-row{
    display:flex; align-items:center; gap:16px;
    width:100%; max-width:720px;
  }
  .hairline{ flex:1; height:1px; background: rgba(20,30,66,0.10); }
  .signature img{ height:32px; width:auto; display:block; opacity:0.9; }
  .signature-label{
    font-family: var(--font-display);
    font-size:11px; font-weight:600; letter-spacing:0.18em;
    text-transform:uppercase; color: var(--ink-mid);
  }
</style>
