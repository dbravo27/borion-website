---
import Art_CPG from './Art_CPG.astro';
import Art_Deck from './Art_Deck.astro';
import Art_Handoff from './Art_Handoff.astro';

export interface Props {
  href: string;
  eyebrow: string;
  title: string;
  date: string;       // formatted, e.g. "May 11, 2026"
  readMin: number;
  art: 'cpg' | 'deck' | 'handoff';
}
const { href, eyebrow, title, date, readMin, art } = Astro.props;
---
<a href={href} class="blog-card">
  <div class="card-art">
    {art === 'cpg' && <Art_CPG />}
    {art === 'deck' && <Art_Deck />}
    {art === 'handoff' && <Art_Handoff />}
  </div>
  <div class="card-body">
    <div class="eyebrow">{eyebrow}</div>
    <h3 class="title">{title}</h3>
    <div class="meta">
      <span>{date}</span>
      <span>{readMin} min read</span>
    </div>
  </div>
</a>

<style>
  .blog-card{
    display:flex; flex-direction:column;
    width:100%; max-width:480px; height:560px;
    border-radius:18px; overflow:hidden;
    background: linear-gradient(180deg, var(--lavender-soft) 0%, var(--cream) 100%);
    border: 1px solid rgba(111, 93, 210, 0.18);
    color: var(--ink);
    text-decoration:none;
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }
  .blog-card:hover{
    transform: translateY(-4px);
    box-shadow: 0 24px 60px rgba(20, 30, 66, 0.18);
    border-color: rgba(111, 93, 210, 0.4);
  }
  .card-art{ height:240px; position:relative; overflow:hidden; }
  .card-body{
    padding: 28px 32px 32px;
    display:flex; flex-direction:column; gap:12px; flex:1;
    border-top: 1px solid var(--line-soft);
  }
  .eyebrow{
    font-size:10.5px; font-weight:700; letter-spacing:0.16em;
    text-transform:uppercase; color: var(--purple);
    font-family: var(--font-display);
  }
  .title{
    font-family: var(--font-display);
    font-size: 24px; font-weight:600; line-height:1.18; letter-spacing:-0.01em;
    color: var(--ink); margin:0; text-wrap: pretty;
  }
  .meta{
    margin-top:auto; padding-top:16px;
    border-top: 1px solid var(--line-soft);
    display:flex; align-items:center; justify-content:space-between;
    font-size:12px; color: var(--ink-dim);
    font-family: var(--font-display); letter-spacing:0.01em;
  }
</style>
